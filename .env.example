# Supabase — create a project at supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Resend — create an account at resend.com
RESEND_API_KEY=re_your_key

# Your email for internal new-signup notifications
NOTIFY_EMAIL=you@youragency.com

# The "from" domain for Resend (must be verified)
FROM_EMAIL=noreply@suretyos.com
