---
import FounderNote from '../components/FounderNote.astro';
import Footer from '../components/Footer.astro';
import LogoMark from '../components/LogoMark.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>A note from the founder — SuretyOS</title>
  <meta name="description" content="Why Umair Ahmed is building SuretyOS: one intake form, every bond document generated, every renewal tracked — built for surety agencies specifically." />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0e2744" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <meta property="og:type"        content="article" />
  <meta property="og:site_name"   content="SuretyOS" />
  <meta property="og:title"       content="A note from the founder — SuretyOS" />
  <meta property="og:description" content="Why Umair Ahmed is building SuretyOS for surety bond agencies." />
  <meta property="og:url"         content="https://suretyos.com/founder" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  <header class="page-nav" role="banner">
    <div class="container page-nav-inner">
      <a href="/" class="page-logo" aria-label="SuretyOS home">
        <LogoMark size={36} />
        SuretyOS
      </a>
      <a href="/#signup" class="btn btn-primary page-nav-cta">Book a Demo</a>
    </div>
  </header>

  <main id="main">
    <FounderNote />

    <section class="section section--navy founder-cta" aria-labelledby="founder-cta-heading">
      <div class="container founder-cta-inner">
        <h2 id="founder-cta-heading" class="u-headline founder-cta-heading">
          Founding spots are limited to 25 agencies.
        </h2>
        <div class="founder-cta-actions">
          <a href="/#signup" class="btn btn-primary btn-primary-lg">
            Book a Demo &rarr;
          </a>
          <a href="/" class="founder-cta-back">&larr; Back to home</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .page-nav {
      background: var(--navy);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .page-nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }
    .page-logo {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      color: white;
      text-decoration: none;
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.015em;
    }
    .page-logo:focus-visible {
      outline: 2px solid var(--mint);
      outline-offset: 4px;
      border-radius: var(--radius-sm);
    }
    .page-nav-cta {
      padding: 0.6875rem 1.125rem;
      font-size: 0.9375rem;
    }
    @media (max-width: 400px) {
      .page-nav-cta { padding: 0.6875rem 1rem; font-size: 0.875rem; }
    }

    /* ── Closing CTA ── */
    .founder-cta-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-8);
    }
    @media (min-width: 720px) {
      .founder-cta-inner {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }
    .founder-cta-heading {
      color: white;
      max-width: 22ch;
    }
    .founder-cta-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-4);
    }
    .founder-cta-back {
      font-size: var(--text-sm);
      font-weight: 500;
      color: rgba(255, 255, 255, 0.6);
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .founder-cta-back:hover { color: white; }
    .founder-cta-back:focus-visible {
      outline: 2px solid var(--mint);
      outline-offset: 3px;
      border-radius: var(--radius-sm);
    }
  </style>
</body>
</html>
