---
/**
 * SuretyOS mark — "Ledger S".
 * An S built as a continuous right-angled stroke (rows of bond data
 * consolidating into one system), set in a navy tile. The middle row is
 * Action Mint — the single consolidated record. Reads cleanly down to 16px.
 *
 * One source of truth: used in Nav, Footer, LegalLayout, founder page, favicon.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
>
  <rect width="48" height="48" rx="12" fill="#0e2744" />
  <!-- Ledger-S: top row → down-left → middle row → down-right → bottom row -->
  <path
    d="M33 15 H15 V24 H33 V33 H15"
    stroke="#ffffff"
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />
  <!-- The consolidated middle row, in Action Mint -->
  <rect x="15" y="21" width="18" height="6" rx="3" fill="#0d9f7e" />
</svg>
