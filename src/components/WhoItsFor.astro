---
const segments = [
  {
    title: 'Court Bond Agencies',
    specifics: [
      'Probate, guardianship, conservatorship, VA fiduciary, trustee',
      'Conditional forms handle county variation automatically',
      'Non-cancellable bonds flagged and protected',
      'Annual accounting dates tracked',
    ],
  },
  {
    title: 'Commercial & Licence Agencies',
    specifics: [
      'Contractor, auto dealer, freight broker, notary, mortgage broker',
      'High volume, handled fast',
      'Batch-renew hundreds of bonds in an afternoon',
    ],
  },
  {
    title: 'Construction Surety Agencies',
    specifics: [
      'Bid, performance, and payment bonds',
      'Linked bond families carry data forward',
      'Submission packets assemble in one click — meet the bid deadline',
    ],
  },
];
---

<section class="section section--filing" aria-labelledby="who-heading">
  <div class="container">

    <h2 id="who-heading" class="u-headline who-heading" data-reveal>
      Whatever you write, it's built for you.
    </h2>

    <div class="segment-grid">
      {segments.map((seg, i) => (
        <div class="segment" data-reveal data-delay={String(i + 1)}>
          <h3 class="u-title segment-title">{seg.title}</h3>
          <ul class="segment-list" role="list">
            {seg.specifics.map((line) => (
              <li class="segment-item">{line}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .who-heading {
    color: var(--navy);
    max-width: 24ch;
    margin-bottom: var(--sp-12);
  }

  .segment-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
    border-top: 2px solid rgba(26, 58, 92, 0.12);
    padding-top: var(--sp-10);
  }

  @media (min-width: 700px) {
    .segment-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }
  }

  .segment {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  /* Column separators on desktop */
  @media (min-width: 700px) {
    .segment + .segment {
      border-left: 1px solid rgba(26, 58, 92, 0.1);
      padding-left: var(--sp-8);
    }
  }

  .segment-title {
    color: var(--navy);
  }

  .segment-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .segment-item {
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--ink-secondary);
    padding-left: var(--sp-4);
    position: relative;
    text-wrap: pretty;
  }

  .segment-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--teal);
    flex-shrink: 0;
  }
</style>
