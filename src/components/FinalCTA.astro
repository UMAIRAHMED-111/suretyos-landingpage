<section class="section section--navy final-cta" aria-labelledby="final-heading">
  <div class="container final-inner">
    <h2 id="final-heading" class="u-headline final-heading" data-reveal>
      Your bond workflow, without the manual steps.
    </h2>
    <div data-reveal data-delay="1">
      <a href="#signup" class="btn btn-primary btn-primary-lg">
        Join the Founding Program &rarr;
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
  }

  .final-cta::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 300px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center, rgba(14, 124, 134, 0.18), transparent 70%);
    border-radius: 50%;
    animation: cta-pulse 7s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes cta-pulse {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(0.9); }
    50%       { opacity: 1;   transform: translate(-50%, -50%) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta::before { animation: none; }
  }

  .final-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-8);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 640px) {
    .final-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .final-heading {
    color: white;
    max-width: 22ch;
  }
</style>
