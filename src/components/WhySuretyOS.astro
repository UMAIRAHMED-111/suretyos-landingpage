---
const features = [
  {
    title: 'One intake, every document',
    body: 'A single submission fills the bond form, power of attorney, indemnity agreement, and court cover sheet.',
    icon: 'doc',
  },
  {
    title: 'Renewals that never slip',
    body: 'Automatic alerts at 90, 60, 30, and 15 days. Review and renew in one click for the life of the bond.',
    icon: 'clock',
  },
  {
    title: 'A searchable bond repository',
    body: 'Find any bond by client, carrier, county, or case number in seconds. No more email-thread archaeology.',
    icon: 'search',
  },
  {
    title: 'Built for every carrier',
    body: 'One workflow across your carriers and their forms, instead of one portal and one template at a time.',
    icon: 'layers',
  },
  {
    title: 'County-specific court bonds',
    body: 'Probate, guardianship, VA fiduciary, and the local cover sheets each court actually requires.',
    icon: 'pin',
  },
  {
    title: 'Surety-native, not adapted',
    body: 'Designed around how surety actually works, not retrofitted from general P&C insurance software.',
    icon: 'badge',
  },
];

// Duotone icons: a soft filled shape + a stroked detail.
const icons: Record<string, string> = {
  doc: `<path d="M6 3h7l5 5v13H6z" fill="currentColor" opacity="0.16"/><path d="M6 3h7l5 5v13H6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13 3v5h5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 13h6M9 16.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  clock: `<circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.16"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V12l3.2 1.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  search: `<circle cx="11" cy="11" r="6.5" fill="currentColor" opacity="0.16"/><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 16l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
  layers: `<path d="M12 3l9 5-9 5-9-5z" fill="currentColor" opacity="0.16"/><path d="M12 3l9 5-9 5-9-5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.5 12.5L12 17l8.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
  pin: `<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z" fill="currentColor" opacity="0.16"/><path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/>`,
  badge: `<path d="M12 2.5l2.3 1.7 2.8-.1.9 2.7 2.3 1.6-.9 2.7.9 2.7-2.3 1.6-.9 2.7-2.8-.1L12 21.5l-2.3-1.7-2.8.1-.9-2.7-2.3-1.6.9-2.7-.9-2.7 2.3-1.6.9-2.7 2.8.1z" fill="currentColor" opacity="0.16"/><path d="M12 2.5l2.3 1.7 2.8-.1.9 2.7 2.3 1.6-.9 2.7.9 2.7-2.3 1.6-.9 2.7-2.8-.1L12 21.5l-2.3-1.7-2.8.1-.9-2.7-2.3-1.6.9-2.7-.9-2.7 2.3-1.6.9-2.7 2.8.1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.7 12l2.2 2.2 4.4-4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
};
---

<section class="section section--white why" aria-labelledby="why-heading">
  <div class="container">
    <div class="why-header" data-reveal>
      <h2 id="why-heading" class="u-headline">Why surety agencies choose SuretyOS.</h2>
      <p class="why-sub">
        Every feature exists to remove a specific piece of the manual bond workflow you run today.
      </p>
    </div>

    <ul class="why-grid" role="list">
      {features.map((f, i) => (
        <li class="why-item" data-reveal data-delay={String((i % 3) + 1)}>
          <span class="why-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" set:html={icons[f.icon]} />
          </span>
          <h3 class="why-item-title">{f.title}</h3>
          <p class="why-item-body">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why-header {
    max-width: 48ch;
    margin-bottom: var(--sp-12);
  }
  .why-header h2 { color: var(--navy); }
  .why-sub {
    margin-top: var(--sp-4);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .why-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10) var(--sp-12);
  }

  @media (min-width: 620px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 940px) {
    .why-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .why-item {
    padding-top: var(--sp-5);
    border-top: 2px solid var(--filing);
  }

  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(14, 124, 134, 0.1);
    box-shadow: inset 0 0 0 1px rgba(14, 124, 134, 0.22);
    color: var(--teal);
    margin-bottom: var(--sp-4);
  }

  .why-item-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--navy);
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
  }

  .why-item-body {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 38ch;
    text-wrap: pretty;
  }
</style>
