---
import Icon from './Icon.astro';

const features = [
  {
    title: 'One intake, every document',
    body: 'A single submission fills the bond form, power of attorney, indemnity agreement, and court cover sheet.',
    icon: 'file-text',
  },
  {
    title: 'Renewals that never slip',
    body: 'Automatic alerts at 90, 60, 30, and 15 days. Review and renew in one click for the life of the bond.',
    icon: 'bell-ring',
  },
  {
    title: 'A searchable bond repository',
    body: 'Find any bond by client, carrier, county, or case number in seconds. No more email-thread archaeology.',
    icon: 'search',
  },
  {
    title: 'Built for every carrier',
    body: 'One workflow across your carriers and their forms, instead of one portal and one template at a time.',
    icon: 'layers',
  },
  {
    title: 'County-specific court bonds',
    body: 'Probate, guardianship, VA fiduciary, and the local cover sheets each court actually requires.',
    icon: 'map-pin',
  },
  {
    title: 'Surety-native, not adapted',
    body: 'Designed around how surety actually works, not retrofitted from general P&C insurance software.',
    icon: 'shield-check',
  },
];
---

<section class="section section--white why" aria-labelledby="why-heading">
  <div class="container">
    <div class="why-header" data-reveal>
      <h2 id="why-heading" class="u-headline">Why surety agencies choose SuretyOS.</h2>
      <p class="why-sub">
        Every feature exists to remove a specific piece of the manual bond workflow you run today.
      </p>
    </div>

    <ul class="why-grid" role="list">
      {features.map((f, i) => (
        <li class="why-item" data-reveal data-delay={String((i % 3) + 1)}>
          <span class="why-icon" aria-hidden="true">
            <Icon name={f.icon} size={22} />
          </span>
          <h3 class="why-item-title">{f.title}</h3>
          <p class="why-item-body">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why-header {
    max-width: 48ch;
    margin-bottom: var(--sp-12);
  }
  .why-header h2 { color: var(--navy); }
  .why-sub {
    margin-top: var(--sp-4);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .why-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10) var(--sp-12);
  }

  @media (min-width: 620px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 940px) {
    .why-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .why-item {
    padding-top: var(--sp-5);
    border-top: 2px solid var(--filing);
  }

  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: var(--navy);
    color: #fff;
    margin-bottom: var(--sp-5);
    box-shadow: 0 6px 16px rgba(14, 39, 68, 0.18);
    transition: transform 0.25s ease;
  }
  .why-item:hover .why-icon { transform: translateY(-2px); }

  .why-item-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--navy);
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
  }

  .why-item-body {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 38ch;
    text-wrap: pretty;
  }
</style>
