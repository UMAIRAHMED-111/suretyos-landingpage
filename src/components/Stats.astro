---
import VideoBg from './VideoBg.astro';
// Honest value-math + program facts — no fabricated traction.
const stats = [
  { to: 4,  suffix: '',  label: 'documents from one intake', sub: 'Bond form, POA, indemnity, court cover sheet' },
  { to: 3,  suffix: 's', label: 'to generate a full packet', sub: 'You review and approve the output' },
  { to: 4,  suffix: '',  label: 'renewal alerts per bond', sub: '90, 60, 30, and 15 days out' },
  { to: 25, suffix: '',  label: 'founding-agency spots', sub: 'Lifetime founder pricing, then closed' },
];
---

<section class="section section--navy stats" aria-labelledby="stats-heading">
  <VideoBg src="/video/bg-team-1.mp4" />
  <div class="container">
    <h2 id="stats-heading" class="stats-heading" data-reveal>
      The math of one bond, done right.
    </h2>

    <dl class="stats-grid">
      {stats.map((s, i) => (
        <div class="stat" data-reveal data-delay={String(i + 1)}>
          <dt
            class="stat-figure"
            data-count-to={s.to}
            data-count-suffix={s.suffix}
          >0{s.suffix}</dt>
          <dd class="stat-label">{s.label}</dd>
          <dd class="stat-sub">{s.sub}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats { position: relative; overflow: hidden; }
  .stats .container { position: relative; z-index: 1; }

  .stats-heading {
    font-family: var(--font-display);
    font-size: var(--text-headline);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #fff;
    text-align: center;
    max-width: 22ch;
    margin: 0 auto var(--sp-16);
    text-wrap: balance;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-12) var(--sp-6);
  }

  @media (min-width: 860px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stat {
    text-align: center;
    padding: 0 var(--sp-2);
    position: relative;
  }

  /* Hairline dividers between columns on wide screens */
  @media (min-width: 860px) {
    .stat + .stat::before {
      content: '';
      position: absolute;
      left: calc(var(--sp-3) * -1);
      top: 8px;
      bottom: 8px;
      width: 1px;
      background: rgba(255, 255, 255, 0.1);
    }
  }

  .stat-figure {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 7vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--mint);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--sp-3);
  }

  .stat-label {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-2);
    text-wrap: balance;
  }

  .stat-sub {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    max-width: 24ch;
    margin: 0 auto;
    text-wrap: pretty;
  }
</style>

<script>
  const DURATION = 1300;
  const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));

  function run(el: HTMLElement, target: number, suffix: string) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { el.textContent = target + suffix; return; }
    const start = performance.now();
    function step(now: number) {
      const t = Math.min((now - start) / DURATION, 1);
      el.textContent = Math.round(easeOutExpo(t) * target) + suffix;
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const obs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      obs.unobserve(el);
      run(el, parseInt(el.dataset.countTo || '0', 10), el.dataset.countSuffix || '');
    });
  }, { threshold: 0.6 });

  document.querySelectorAll<HTMLElement>('.stat-figure[data-count-to]').forEach((el) => obs.observe(el));
</script>
