---
// Ambient looping video background for a section. Heavy navy scrim keeps the
// brand identity and text contrast intact — the video reads as subtle motion,
// not a literal scene. Lazy-loaded when near the viewport; disabled on mobile
// and for prefers-reduced-motion (the section's own navy bg shows instead).
interface Props {
  src: string;
  mode?: 'grey' | 'navy';
}
const { src, mode = 'grey' } = Astro.props;
---

<div class={`video-bg video-bg--${mode}`} aria-hidden="true">
  <video class="video-bg-el" muted loop playsinline preload="none" data-vsrc={src}></video>
  <span class="video-bg-scrim"></span>
</div>

<style>
  .video-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .video-bg-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .video-bg-el.is-ready { opacity: 0.6; }

  /* Greyed-out variant: desaturated footage + grey scrim */
  .video-bg--grey .video-bg-el { filter: grayscale(100%) contrast(1.04); }
  .video-bg--grey .video-bg-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 50% 30%, rgba(18, 24, 33, 0.55), rgba(15, 20, 28, 0.78) 75%),
      linear-gradient(180deg, rgba(17, 23, 32, 0.7), rgba(14, 19, 27, 0.8));
  }

  /* Navy variant (hero): cool footage under a navy wash, darker behind the
     left-hand copy and lighter on the right so the skyline reads through. */
  .video-bg--navy .video-bg-el { filter: saturate(0.9); }
  .video-bg--navy .video-bg-el.is-ready { opacity: 0.85; }
  .video-bg--navy .video-bg-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 39, 68, 0.95) 0%, rgba(14, 39, 68, 0.78) 38%, rgba(12, 31, 54, 0.42) 100%),
      linear-gradient(180deg, rgba(14, 39, 68, 0.35), rgba(10, 25, 44, 0.6));
  }

  /* Perf: no video on small screens; brand navy bg shows through */
  @media (max-width: 760px) {
    .video-bg-el { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .video-bg-el { display: none; }
  }
</style>

<script>
  // Lazy-load each video when its section nears the viewport; pause off-screen.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const small = window.matchMedia('(max-width: 760px)').matches;

  if (!reduce && !small) {
    const vids = document.querySelectorAll<HTMLVideoElement>('.video-bg-el[data-vsrc]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const v = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          if (!v.src) {
            v.src = v.dataset.vsrc || '';
            v.addEventListener('loadeddata', () => v.classList.add('is-ready'), { once: true });
          }
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    }, { rootMargin: '200px 0px' });

    vids.forEach((v) => io.observe(v));
  }
</script>
