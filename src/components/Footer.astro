---
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="SuretyOS home">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M11 2L19.66 7v8L11 20 2.34 15V7L11 2z" fill="none" stroke="#02c39a" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M11 2L19.66 7v8L11 20 2.34 15V7L11 2z" fill="#0e7c86" fill-opacity="0.25"/>
        </svg>
        SuretyOS
      </a>
      <p class="footer-copy">&copy; {year} SuretyOS. All rights reserved.</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <a href="mailto:hello@suretyos.com" class="footer-link">hello@suretyos.com</a>
      <a href="/privacy" class="footer-link">Privacy policy</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    padding: var(--sp-10) 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .footer-logo:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.35);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 2px;
    border-radius: 2px;
    color: rgba(255, 255, 255, 0.8);
  }
</style>
