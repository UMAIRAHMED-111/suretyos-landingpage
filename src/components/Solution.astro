---
const capabilities = [
  {
    name: 'Smart Intake Forms',
    description:
      'Send clients a link. They fill a form tailored to the bond type and submit once. Structured data arrives in your dashboard with no email follow-up.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="3"/>
      <path d="M8 8h8M8 12h8M8 16h5"/>
    </svg>`,
  },
  {
    name: 'One-Click Document Generation',
    description:
      'Upload your templates once. Every bond after that generates all four documents pre-filled in seconds.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 3v4a1 1 0 001 1h4"/>
      <path d="M17 21H7a2 2 0 01-2-2V5a2 2 0 012-2h7l5 5v11a2 2 0 01-2 2z"/>
      <path d="M9 17l2-2 2 2M11 15v-4"/>
    </svg>`,
  },
  {
    name: 'Searchable Bond Repository',
    description:
      'Every bond you\'ve written in one place, searchable by client name, carrier, county, or case number.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="7"/>
      <path d="M21 21l-4.35-4.35"/>
    </svg>`,
  },
  {
    name: 'Automated Renewal Tracking',
    description:
      'Alerts at 90, 60, 30, and 15 days before expiry. Review and renew with one click when the time comes.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
      <path d="M13.73 21a2 2 0 01-3.46 0"/>
    </svg>`,
  },
];
---

<section class="section section--filing" aria-labelledby="solution-heading">
  <div class="container">

    <h2 id="solution-heading" class="u-headline solution-heading" data-reveal>
      How SuretyOS handles the work.
    </h2>

    <div class="capability-grid">
      {capabilities.map((cap, i) => (
        <div class="capability-item" data-reveal data-delay={String(i + 1)}>
          <div class="cap-icon" aria-hidden="true" set:html={cap.icon} />
          <div class="cap-body">
            <h3 class="u-title cap-name">{cap.name}</h3>
            <p class="cap-desc">{cap.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .solution-heading {
    color: var(--navy);
    max-width: 28ch;
    margin-bottom: var(--sp-12);
  }

  /* 2-column grid on desktop, 1-column on mobile */
  .capability-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid rgba(26, 58, 92, 0.1);
    border-radius: var(--radius-lg);
    background: white;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 700px) {
    .capability-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .capability-item {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-8) var(--sp-8);
    border-bottom: 1px solid rgba(26, 58, 92, 0.08);
    transition: background 0.15s ease;
  }

  /* 2-column: right column items — add left border */
  @media (min-width: 700px) {
    .capability-item:nth-child(even) {
      border-left: 1px solid rgba(26, 58, 92, 0.08);
    }
    /* last row: no bottom border */
    .capability-item:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  /* 1-column: last item no border */
  @media (max-width: 699px) {
    .capability-item:last-child { border-bottom: none; }
  }

  .capability-item:hover {
    background: rgba(238, 243, 248, 0.6);
  }

  .cap-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 124, 134, 0.08);
    border-radius: var(--radius-md);
    color: var(--teal);
  }

  .cap-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
  }

  .cap-name {
    color: var(--navy);
  }

  .cap-desc {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }
</style>
