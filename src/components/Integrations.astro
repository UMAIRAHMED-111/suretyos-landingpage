---
// Honest "connects with your stack" strip. Real brand marks (favicons /
// official SVG) shown beside the name so lower-res carrier marks still read.
// These are the systems SuretyOS is built to integrate with — not customers.
type Integration = { name: string; logo: string };
const groups: { label: string; items: Integration[] }[] = [
  {
    label: 'Carriers & sureties',
    items: [
      { name: 'Liberty Mutual', logo: '/logos/liberty-mutual.png' },
      { name: 'Travelers', logo: '/logos/travelers.png' },
      { name: 'CNA Surety', logo: '/logos/cna-surety.png' },
      { name: 'Merchants Bonding', logo: '/logos/merchants-bonding.png' },
      { name: 'The Hartford', logo: '/logos/the-hartford.png' },
    ],
  },
  {
    label: 'Agency management',
    items: [
      { name: 'AMS360', logo: '/logos/ams360.png' },
      { name: 'Applied Epic', logo: '/logos/applied-epic.png' },
      { name: 'EZLynx', logo: '/logos/ezlynx.png' },
      { name: 'Vertafore', logo: '/logos/vertafore.png' },
    ],
  },
  {
    label: 'CRM & tools',
    items: [
      { name: 'Salesforce', logo: '/logos/salesforce.svg' },
      { name: 'HubSpot', logo: '/logos/hubspot.png' },
      { name: 'QuickBooks', logo: '/logos/quickbooks.png' },
      { name: 'DocuSign', logo: '/logos/docusign.png' },
    ],
  },
];

const all = groups.flatMap((g) => g.items);
---

<section class="integrations" aria-labelledby="integrations-heading">
  <div class="container">
    <p id="integrations-heading" class="integrations-title" data-reveal>
      Designed to work with the carriers, agency systems, and tools you already use.
    </p>

    <div class="logo-wall" aria-hidden="true">
      <div class="logo-track">
        {[...all, ...all].map((item) => (
          <span class="logo-slot">
            <img class="logo-mk" src={item.logo} alt="" loading="lazy" width="24" height="24" />
            <span class="logo-nm">{item.name}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Accessible, grouped list (also the layout shown when motion is reduced) -->
    <ul class="integrations-groups" data-reveal data-delay="1">
      {groups.map((g) => (
        <li class="int-group">
          <span class="int-group-label">{g.label}</span>
          <span class="int-group-items">{g.items.map((i) => i.name).join(' · ')}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .integrations {
    background: var(--white);
    border-bottom: 1px solid var(--filing);
    padding: var(--sp-16) 0;
    overflow: hidden;
  }

  .integrations-title {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--navy);
    letter-spacing: -0.01em;
    max-width: 34ch;
    margin: 0 auto var(--sp-10);
    text-wrap: balance;
  }

  /* ── Logo wall (marquee) ── */
  .logo-wall {
    position: relative;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .logo-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: var(--sp-10);
    animation: marquee 48s linear infinite;
  }
  .logo-wall:hover .logo-track { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .logo-slot {
    flex-shrink: 0;
    height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo-mk {
    height: 24px;
    width: 24px;
    object-fit: contain;
    border-radius: 5px;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .logo-nm {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-secondary);
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .logo-slot:hover .logo-mk { filter: none; opacity: 1; }
  .logo-slot:hover .logo-nm { color: var(--navy); }

  /* ── Grouped fallback (reduced motion) ── */
  .integrations-groups {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-4) var(--sp-10);
    margin-top: var(--sp-8);
  }
  .int-group { display: flex; flex-direction: column; gap: 3px; text-align: center; }
  .int-group-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .int-group-items {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-tertiary);
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-wall { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .integrations-groups { display: none; }
  }
</style>
