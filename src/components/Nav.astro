---
import LogoMark from "./LogoMark.astro";
---

<header class="site-nav" role="banner">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="SuretyOS home">
      <LogoMark class="logo-mark" size={36} />
      SuretyOS
    </a>

    <a href="#signup" class="btn btn-primary nav-cta">
      Join the Program
    </a>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-sticky);
    /* starts transparent — hero is navy so it looks seamless */
    background: transparent;
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .site-nav.is-scrolled {
    background: var(--navy);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: white;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .nav-logo:focus-visible {
    outline: 2px solid var(--mint);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .nav-cta {
    /* min 44px tall for comfortable thumb tapping */
    padding: 0.6875rem 1.125rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 400px) {
    .nav-cta {
      padding: 0.6875rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>
