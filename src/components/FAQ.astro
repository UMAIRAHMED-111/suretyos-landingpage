---
const faqs = [
  {
    q: 'Is this another generic insurance platform?',
    a: 'No. SuretyOS is built specifically for surety bond workflows: intake, document generation, and renewals for commercial, court, and construction bonds. It is not adapted from P&C or general insurance software.',
  },
  {
    q: 'How does document generation work?',
    a: 'You upload your existing Word or PDF templates once, tagging the fields you want auto-filled. When a client submits an intake form, SuretyOS maps their data to every tagged field across all four documents and generates them instantly. No copy-paste, no reformatting.',
  },
  {
    q: 'What bond types does it support?',
    a: 'Court and fiduciary bonds (guardianship, administrator, executor), commercial and license bonds, construction and contract bonds, and fidelity bonds. If you write a bond type not listed, contact us. We scope new bond types during the founding program.',
  },
  {
    q: 'Do I need to leave my carrier portals?',
    a: 'No. SuretyOS sits alongside your existing carrier relationships. It handles the document prep and client intake on your end. You still submit to carriers the way you do today.',
  },
  {
    q: 'How long does setup take?',
    a: 'Most agencies are fully set up within a week. We handle onboarding personally for founding members: template tagging, data migration from your spreadsheets, and a walkthrough with your team.',
  },
  {
    q: 'What happens if my templates change?',
    a: 'Update the template in SuretyOS once. Every bond generated after that uses the new version. Old bonds are unaffected.',
  },
  {
    q: 'Can multiple staff members use it?',
    a: 'Yes. SuretyOS is built for agency teams. All plans include multiple seats. Permissions and access levels are on the roadmap for the first public release.',
  },
  {
    q: 'Is there a free trial?',
    a: 'We are not doing a self-serve trial during the founding phase. Instead, founding members get a live walkthrough and a hands-on setup session with us. That gives you a real picture of the workflow, not a demo environment.',
  },
  {
    q: 'Is my data secure?',
    a: 'SOC 2-aligned architecture from day one. Encryption in transit and at rest. Your data is yours, exportable at any time in standard formats. No vendor lock-in.',
  },
  {
    q: 'When does it launch publicly?',
    a: 'We are onboarding founding agencies in waves as we build. Join now to secure your spot and lifetime pricing. We will be in touch within 48 hours to schedule a call.',
  },
];
---

<section class="section section--filing" aria-labelledby="faq-heading">
  <div class="container faq-inner">

    <h2 id="faq-heading" class="u-headline faq-heading" data-reveal>
      Common questions
    </h2>

    <div class="faq-list" role="list">
      {faqs.map((faq, i) => (
        <div class="faq-item" role="listitem" data-reveal data-delay={String((i % 4) + 1)}>
          <button
            class="faq-question"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
            type="button"
          >
            <span>{faq.q}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="faq-answer" id={`faq-answer-${i}`} role="region">
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-inner {
    max-width: 760px;
  }

  .faq-heading {
    color: var(--navy);
    margin-bottom: var(--sp-10);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(26, 58, 92, 0.12);
  }

  .faq-item {
    border-bottom: 1px solid rgba(26, 58, 92, 0.12);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    padding: var(--sp-5) 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--navy);
    text-align: left;
    line-height: 1.45;
    -webkit-tap-highlight-color: transparent;
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--teal);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-question[aria-expanded="true"] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    overflow: hidden;
    height: 0;
    transition: height 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-answer p {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--ink-secondary);
    padding-bottom: var(--sp-5);
    max-width: 58ch;
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    .faq-question { font-size: var(--text-lg); }
    .faq-answer p  { font-size: var(--text-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer    { transition: none; }
    .faq-chevron   { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.faq-item').forEach((item) => {
    const btn    = item.querySelector<HTMLButtonElement>('.faq-question')!;
    const answer = item.querySelector<HTMLElement>('.faq-answer')!;
    let busy = false;

    btn.addEventListener('click', () => {
      if (busy) return;
      busy = true;

      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        // Collapse
        btn.setAttribute('aria-expanded', 'false');
        answer.style.height = answer.scrollHeight + 'px';
        requestAnimationFrame(() => {
          answer.style.height = '0';
        });
        setTimeout(() => {
          answer.style.height = '';
          busy = false;
        }, 340);
      } else {
        // Expand
        btn.setAttribute('aria-expanded', 'true');
        const h = answer.scrollHeight;
        answer.style.height = '0';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            answer.style.height = h + 'px';
          });
        });
        answer.addEventListener('transitionend', () => {
          answer.style.height = 'auto'; // 'auto' keeps it open; '' would reset to CSS height:0
          busy = false;
        }, { once: true });
      }
    });
  });
</script>
